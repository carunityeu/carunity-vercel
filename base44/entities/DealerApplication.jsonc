{
  "name": "DealerApplication",
  "type": "object",
  "properties": {
    "dealer_name": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0430\u0432\u0442\u043e\u0441\u0430\u043b\u043e\u043d\u0430"
    },
    "applicant_email": {
      "type": "string",
      "description": "Email \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u0430 \u0437\u0430\u044f\u0432\u0438\u0442\u0435\u043b\u044f"
    },
    "applicant_name": {
      "type": "string",
      "description": "\u041a\u043e\u043d\u0442\u0430\u043a\u0442\u043d\u043e\u0435 \u043b\u0438\u0446\u043e"
    },
    "contact_email": {
      "type": "string",
      "description": "\u0420\u0430\u0431\u043e\u0447\u0430\u044f \u043f\u043e\u0447\u0442\u0430 \u0430\u0432\u0442\u043e\u0441\u0430\u043b\u043e\u043d\u0430"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "brands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "website": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "import_requested": {
      "type": "boolean",
      "default": false
    },
    "import_url": {
      "type": "string"
    },
    "data_usage_consent": {
      "type": "boolean",
      "default": false
    },
    "gdpr_consent": {
      "type": "boolean",
      "default": false
    },
    "terms_consent": {
      "type": "boolean",
      "default": false
    },
    "consented_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "admin_notes": {
      "type": "string",
      "description": "\u041a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439 \u043f\u043e \u0437\u0430\u044f\u0432\u043a\u0435, \u0432\u0438\u0434\u0435\u043d \u0437\u0430\u044f\u0432\u0438\u0442\u0435\u043b\u044e"
    },
    "dealer_id": {
      "type": "string",
      "description": "\u0414\u0438\u043b\u0435\u0440 \u043f\u043e\u0441\u043b\u0435 \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u0438\u044f"
    }
  },
  "required": [
    "dealer_name",
    "applicant_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.applicant_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}