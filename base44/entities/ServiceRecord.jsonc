{
  "name": "ServiceRecord",
  "type": "object",
  "properties": {
    "car_id": {
      "type": "string",
      "description": "ID \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u0414\u0430\u0442\u0430 \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f"
    },
    "type": {
      "type": "string",
      "enum": [
        "maintenance",
        "repair",
        "parts",
        "inspection",
        "other"
      ],
      "description": "\u0422\u0438\u043f \u0440\u0430\u0431\u043e\u0442\u044b"
    },
    "mileage": {
      "type": "number",
      "description": "\u041f\u0440\u043e\u0431\u0435\u0433 \u043d\u0430 \u043c\u043e\u043c\u0435\u043d\u0442 \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f (\u043a\u043c)"
    },
    "description": {
      "type": "string",
      "description": "\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u044b\u0445 \u0440\u0430\u0431\u043e\u0442 (\u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b)"
    },
    "description_en": {
      "type": "string",
      "description": "\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u043d\u0430 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u043c"
    },
    "description_ru": {
      "type": "string",
      "description": "\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u043d\u0430 \u0440\u0443\u0441\u0441\u043a\u043e\u043c"
    },
    "description_et": {
      "type": "string",
      "description": "\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u043d\u0430 \u044d\u0441\u0442\u043e\u043d\u0441\u043a\u043e\u043c"
    },
    "description_lv": {
      "type": "string",
      "description": "\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u043d\u0430 \u043b\u0430\u0442\u044b\u0448\u0441\u043a\u043e\u043c"
    },
    "description_lt": {
      "type": "string",
      "description": "\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u043d\u0430 \u043b\u0438\u0442\u043e\u0432\u0441\u043a\u043e\u043c"
    },
    "workshop_name": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0421\u0422\u041e / \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u043e\u0439"
    },
    "cost": {
      "type": "number",
      "description": "\u0421\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c (\u20ac)"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0424\u043e\u0442\u043e \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u0432 / \u0447\u0435\u043a\u043e\u0432"
    }
  },
  "required": [
    "car_id",
    "date",
    "type"
  ]
}