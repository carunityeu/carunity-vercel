{
  "name": "LuxuryBrand",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043c\u0430\u0440\u043a\u0438"
    },
    "logo": {
      "type": "string",
      "description": "URL \u043b\u043e\u0433\u043e\u0442\u0438\u043f\u0430"
    },
    "logo_width": {
      "type": "number",
      "default": 48,
      "description": "\u0428\u0438\u0440\u0438\u043d\u0430 \u043b\u043e\u0433\u043e\u0442\u0438\u043f\u0430 \u0432 \u043f\u0438\u043a\u0441\u0435\u043b\u044f\u0445"
    },
    "logo_fit": {
      "type": "string",
      "enum": [
        "contain",
        "cover"
      ],
      "default": "contain",
      "description": "\u0420\u0435\u0436\u0438\u043c \u043b\u043e\u0433\u043e\u0442\u0438\u043f\u0430: contain \u2014 \u0432\u043f\u0438\u0441\u0430\u0442\u044c, cover \u2014 \u043e\u0431\u0440\u0435\u0437\u0430\u0442\u044c"
    },
    "image": {
      "type": "string",
      "description": "URL \u0444\u043e\u043d\u043e\u0432\u043e\u0433\u043e \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u0430\u0432\u0442\u043e"
    },
    "badge": {
      "type": "string",
      "description": "\u0411\u0435\u0439\u0434\u0436 (\u043d\u0430\u043f\u0440. \u041d\u043e\u0432\u0438\u043d\u043a\u0438)"
    },
    "subtitle": {
      "type": "string",
      "description": "\u041f\u043e\u0434\u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "\u041f\u043e\u0440\u044f\u0434\u043e\u043a \u0441\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0438"
    },
    "is_published": {
      "type": "boolean",
      "default": false,
      "description": "\u041e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043e"
    },
    "show_name": {
      "type": "boolean",
      "default": true,
      "description": "\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043c\u0430\u0440\u043a\u0438 \u043f\u043e\u0434 \u043b\u043e\u0433\u043e\u0442\u0438\u043f\u043e\u043c"
    },
    "description": {
      "type": "string",
      "description": "\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u043b\u044e\u043a\u0441\u043e\u0432\u043e\u0433\u043e \u0431\u0440\u0435\u043d\u0434\u0430"
    }
  },
  "required": [
    "name"
  ]
}