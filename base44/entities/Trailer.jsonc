{
  "name": "Trailer",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u0417\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a"
    },
    "brand": {
      "type": "string",
      "description": "\u041c\u0430\u0440\u043a\u0430"
    },
    "model": {
      "type": "string",
      "description": "\u041c\u043e\u0434\u0435\u043b\u044c"
    },
    "year": {
      "type": "number",
      "description": "\u0413\u043e\u0434 \u0432\u044b\u043f\u0443\u0441\u043a\u0430"
    },
    "price": {
      "type": "number",
      "description": "\u0426\u0435\u043d\u0430 EUR"
    },
    "original_price": {
      "type": "number",
      "description": "\u0426\u0435\u043d\u0430 \u0434\u043e \u0441\u043a\u0438\u0434\u043a\u0438"
    },
    "trailer_type": {
      "type": "string",
      "enum": [
        "caravan",
        "car_trailer",
        "boat_trailer",
        "flatbed_trailer",
        "curtainsider",
        "refrigerated",
        "tanker",
        "livestock",
        "other"
      ],
      "description": "\u0422\u0438\u043f \u043f\u0440\u0438\u0446\u0435\u043f\u0430"
    },
    "payload_kg": {
      "type": "number",
      "description": "\u0413\u0440\u0443\u0437\u043e\u043f\u043e\u0434\u044a\u0451\u043c\u043d\u043e\u0441\u0442\u044c (\u043a\u0433)"
    },
    "length_m": {
      "type": "number",
      "description": "\u0414\u043b\u0438\u043d\u0430 (\u043c)"
    },
    "axles": {
      "type": "number",
      "description": "\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043e\u0441\u0435\u0439"
    },
    "color": {
      "type": "string",
      "description": "\u0426\u0432\u0435\u0442"
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "used"
      ],
      "description": "\u0421\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0424\u043e\u0442\u043e"
    },
    "description": {
      "type": "string",
      "description": "\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435"
    },
    "location": {
      "type": "string",
      "description": "\u0413\u043e\u0440\u043e\u0434"
    },
    "country": {
      "type": "string",
      "description": "\u0421\u0442\u0440\u0430\u043d\u0430"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "sold",
        "pending",
        "rejected"
      ],
      "default": "pending"
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    },
    "seller_type": {
      "type": "string",
      "enum": [
        "private",
        "dealer"
      ]
    },
    "seller_id": {
      "type": "string"
    },
    "views_count": {
      "type": "number",
      "default": 0
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "brand",
    "year",
    "price"
  ]
}