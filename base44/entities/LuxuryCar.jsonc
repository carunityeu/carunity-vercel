    "condition": {
      "type": "string",
      "description": "\u0421\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 (\u043d\u0430\u043f\u0440. Brand new)"
    },
    "price": {
      "type": "number",
      "description": "\u0426\u0435\u043d\u0430 \u0432 EUR"
    },
    "image": {
      "type": "string",
      "description": "URL PNG-\u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0431\u0435\u0437 \u0444\u043e\u043d\u0430"
    },
    "logo": {
      "type": "string",
      "description": "URL \u043b\u043e\u0433\u043e\u0442\u0438\u043f\u0430 \u0431\u0440\u0435\u043d\u0434\u0430"
    },
    "logo_width": {
      "type": "number",
      "default": 48,
      "description": "\u0428\u0438\u0440\u0438\u043d\u0430 \u043b\u043e\u0433\u043e\u0442\u0438\u043f\u0430 \u0432 \u043f\u0438\u043a\u0441\u0435\u043b\u044f\u0445"
    },
    "link_url": {
      "type": "string",
      "description": "\u0421\u0441\u044b\u043b\u043a\u0430 \u043a\u0443\u0434\u0430 \u0432\u0435\u0434\u0451\u0442 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0430"
    },
    "badge": {
      "type": "string",
      "description": "\u0411\u0435\u0439\u0434\u0436 \u043d\u0430 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0435"
    },
    "rating": {
      "type": "number",
      "description": "\u0420\u0435\u0439\u0442\u0438\u043d\u0433 \u0438\u0437 10"
