{
  "name": "Review",
  "type": "object",
  "properties": {
    "author_email": {
      "type": "string",
      "description": "Email \u0430\u0432\u0442\u043e\u0440\u0430"
    },
    "dealer_id": {
      "type": "string",
      "description": "ID \u0434\u0438\u043b\u0435\u0440\u0430"
    },
    "rating": {
      "type": "number",
      "description": "\u041e\u0446\u0435\u043d\u043a\u0430 1-5"
    },
    "title": {
      "type": "string",
      "description": "\u0417\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a"
    },
    "content": {
      "type": "string",
      "description": "\u0422\u0435\u043a\u0441\u0442 \u043e\u0442\u0437\u044b\u0432\u0430"
    },
    "is_verified_purchase": {
      "type": "boolean",
      "default": false,
      "description": "\u041f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043d\u043d\u0430\u044f \u043f\u043e\u043a\u0443\u043f\u043a\u0430"
    }
  },
  "required": [
    "author_email",
    "dealer_id",
    "rating"
  ]
}