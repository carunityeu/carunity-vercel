{
  "name": "Truck",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u0417\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a"
    },
    "brand": {
      "type": "string",
      "description": "\u041c\u0430\u0440\u043a\u0430"
    },
    "model": {
      "type": "string",
      "description": "\u041c\u043e\u0434\u0435\u043b\u044c"
    },
    "year": {
      "type": "number",
      "description": "\u0413\u043e\u0434 \u0432\u044b\u043f\u0443\u0441\u043a\u0430"
    },
    "price": {
      "type": "number",
      "description": "\u0426\u0435\u043d\u0430 EUR"
    },
    "original_price": {
      "type": "number",
      "description": "\u0426\u0435\u043d\u0430 \u0434\u043e \u0441\u043a\u0438\u0434\u043a\u0438"
    },
    "mileage": {
      "type": "number",
      "description": "\u041f\u0440\u043e\u0431\u0435\u0433 \u043a\u043c"
    },
    "engine_volume": {
      "type": "number",
      "description": "\u041e\u0431\u044a\u0451\u043c \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f (\u043b)"
    },
    "engine_power": {
      "type": "number",
      "description": "\u041c\u043e\u0449\u043d\u043e\u0441\u0442\u044c (\u043b.\u0441.)"
    },
    "fuel_type": {
      "type": "string",
      "enum": [
        "diesel",
        "petrol",
        "electric",
        "gas",
        "hybrid"
      ],
      "description": "\u0422\u0438\u043f \u0442\u043e\u043f\u043b\u0438\u0432\u0430"
    },
    "transmission": {
      "type": "string",
      "enum": [
        "manual",
        "automatic"
      ],
      "description": "\u041a\u041f\u041f"
    },
    "truck_type": {
      "type": "string",
      "enum": [
        "semi_truck",
        "box_truck",
        "flatbed",
        "refrigerated",
        "tanker",
        "tipper",
        "curtainsider",
        "other"
      ],
      "description": "\u0422\u0438\u043f \u0433\u0440\u0443\u0437\u043e\u0432\u0438\u043a\u0430"
    },
    "payload_kg": {
      "type": "number",
      "description": "\u0413\u0440\u0443\u0437\u043e\u043f\u043e\u0434\u044a\u0451\u043c\u043d\u043e\u0441\u0442\u044c (\u043a\u0433)"
    },
    "axles": {
      "type": "number",
      "description": "\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043e\u0441\u0435\u0439"
    },
    "emission_class": {
      "type": "string",
      "description": "\u042d\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043a\u043b\u0430\u0441\u0441 (Euro 5/6)"
    },
    "sleeper_cab": {
      "type": "string",
      "enum": [
        "sleeper",
        "no_sleeper"
      ],
      "description": "\u0422\u0438\u043f \u043a\u0430\u0431\u0438\u043d\u044b (\u0441\u043f\u0430\u043b\u044c\u043d\u0438\u043a / \u0431\u0435\u0437 \u0441\u043f\u0430\u043b\u044c\u043d\u0438\u043a\u0430)"
    },
    "axle_config": {
      "type": "string",
      "description": "\u041a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u044f \u043e\u0441\u0435\u0439 (4x2, 6x2, 6x4 \u0438 \u0442.\u0434.)"
    },
    "tachograph": {
      "type": "string",
      "enum": [
        "digital",
        "analog",
        "none"
      ],
      "description": "\u0422\u0430\u0445\u043e\u0433\u0440\u0430\u0444"
    },
    "retarder": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ],
      "description": "\u0420\u0435\u0442\u0430\u0440\u0434\u0435\u0440 / \u043c\u043e\u0442\u043e\u0440\u043d\u044b\u0439 \u0442\u043e\u0440\u043c\u043e\u0437"
    },
    "vin": {
      "type": "string",
      "description": "VIN-\u043d\u043e\u043c\u0435\u0440"
    },
    "color": {
      "type": "string",
      "description": "\u0426\u0432\u0435\u0442"
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "used"
      ],
      "description": "\u0421\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0424\u043e\u0442\u043e"
    },
    "description": {
      "type": "string",
      "description": "\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435"
    },
    "location": {
      "type": "string",
      "description": "\u0413\u043e\u0440\u043e\u0434"
    },
    "country": {
      "type": "string",
      "description": "\u0421\u0442\u0440\u0430\u043d\u0430"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "sold",
        "pending",
        "rejected"
      ],
      "default": "pending"
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    },
    "seller_type": {
      "type": "string",
      "enum": [
        "private",
        "dealer"
      ]
    },
    "seller_id": {
      "type": "string"
    },
    "views_count": {
      "type": "number",
      "default": 0
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "brand",
    "model",
    "year",
    "price"
  ]
}