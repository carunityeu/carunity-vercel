{
  "name": "AdConfiguration",
  "type": "object",
  "properties": {
    "slot": {
      "type": "string",
      "description": "\u0423\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u043a\u043b\u044e\u0447 \u0441\u043b\u043e\u0442\u0430 (hero-main, home-top, catalog-mid, catalog-sidebar, article-top, article-bottom, news-list-top, home-before-news)"
    },
    "title": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0432 \u0430\u0434\u043c\u0438\u043d\u043a\u0435"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "URL \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f"
          },
          "link": {
            "type": "string",
            "description": "\u0421\u0441\u044b\u043b\u043a\u0430 \u043f\u0440\u0438 \u043a\u043b\u0438\u043a\u0435"
          },
          "alt": {
            "type": "string",
            "description": "Alt \u0442\u0435\u043a\u0441\u0442"
          }
        }
      },
      "description": "\u041c\u0430\u0441\u0441\u0438\u0432 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e (\u0434\u043e 5), \u0440\u043e\u0442\u0430\u0446\u0438\u044f \u043f\u0440\u0438 \u043f\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0435. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u043a\u0430\u043a fallback \u0434\u043b\u044f \u044f\u0437\u044b\u043a\u043e\u0432 \u0431\u0435\u0437 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438"
    },
    "link_url": {
      "type": "string",
      "description": "\u0421\u0441\u044b\u043b\u043a\u0430 \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439 \u0432 \u0441\u043b\u043e\u0442\u0435 (\u0435\u0441\u043b\u0438 \u043d\u0435 \u0437\u0430\u0434\u0430\u043d\u0430 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e)"
    },
    "localizations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lang": {
            "type": "string",
            "enum": [
              "ru",
              "en",
              "et",
              "lv",
              "lt"
            ],
            "description": "\u041a\u043e\u0434 \u044f\u0437\u044b\u043a\u0430 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "description": "URL \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f"
                },
                "link": {
                  "type": "string",
                  "description": "\u0421\u0441\u044b\u043b\u043a\u0430 \u043f\u0440\u0438 \u043a\u043b\u0438\u043a\u0435"
                },
                "alt": {
                  "type": "string",
                  "description": "Alt \u0442\u0435\u043a\u0441\u0442"
                }
              }
            },
            "description": "\u0418\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u0434\u0430\u043d\u043d\u043e\u0433\u043e \u044f\u0437\u044b\u043a\u0430 (\u0434\u043e 5)"
          },
          "link_url": {
            "type": "string",
            "description": "\u041e\u0431\u0449\u0430\u044f \u0441\u0441\u044b\u043b\u043a\u0430 \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438"
          }
        },
        "required": [
          "lang"
        ]
      },
      "description": "\u041b\u043e\u043a\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b \u0431\u0430\u043d\u043d\u0435\u0440\u0430 \u043f\u043e \u044f\u0437\u044b\u043a\u0430\u043c. \u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432\u0430\u0440\u0438\u0430\u043d\u0442, \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0439 \u044f\u0437\u044b\u043a\u0443 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430; \u043f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u2014 fallback \u043d\u0430 images \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "\u0412\u043a\u043b\u044e\u0447\u0435\u043d \u043b\u0438 \u0431\u0430\u043d\u043d\u0435\u0440"
    }
  },
  "required": [
    "slot",
    "title"
  ]
}