{
  "name": "PriceOffer",
  "type": "object",
  "properties": {
    "car_id": {
      "type": "string",
      "description": "ID \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f"
    },
    "buyer_email": {
      "type": "string",
      "description": "Email \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f"
    },
    "seller_email": {
      "type": "string",
      "description": "Email \u043f\u0440\u043e\u0434\u0430\u0432\u0446\u0430"
    },
    "offered_price": {
      "type": "number",
      "description": "\u041f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u043d\u0430\u044f \u0446\u0435\u043d\u0430"
    },
    "message": {
      "type": "string",
      "description": "\u0421\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "countered"
      ],
      "default": "pending",
      "description": "\u0421\u0442\u0430\u0442\u0443\u0441"
    },
    "counter_price": {
      "type": "number",
      "description": "\u0412\u0441\u0442\u0440\u0435\u0447\u043d\u0430\u044f \u0446\u0435\u043d\u0430"
    },
    "description": {
      "type": "string",
      "description": "\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f"
    }
  },
  "required": [
    "car_id",
    "buyer_email",
    "seller_email",
    "offered_price"
  ]
}