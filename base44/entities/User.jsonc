{
  "name": "User",
  "type": "object",
  "properties": {
    "phone": {
      "type": "string",
      "description": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d"
    },
    "avatar": {
      "type": "string",
      "description": "URL \u0430\u0432\u0430\u0442\u0430\u0440\u0430"
    },
    "city": {
      "type": "string",
      "description": "\u0413\u043e\u0440\u043e\u0434"
    },
    "country": {
      "type": "string",
      "description": "\u0421\u0442\u0440\u0430\u043d\u0430"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "private",
        "dealer"
      ],
      "default": "private",
      "description": "\u0422\u0438\u043f \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f"
    },
    "dealer_id": {
      "type": "string",
      "description": "ID \u0434\u0438\u043b\u0435\u0440\u0430 (\u0435\u0441\u043b\u0438 dealer)"
    },
    "gdpr_consent": {
      "type": "boolean",
      "default": false,
      "description": "\u0421\u043e\u0433\u043b\u0430\u0441\u0438\u0435 GDPR"
    },
    "gdpr_consent_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u044f GDPR"
    },
    "terms_consent": {
      "type": "boolean",
      "default": false,
      "description": "\u0421\u043e\u0433\u043b\u0430\u0441\u0438\u0435 \u0441 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u043c\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f"
    },
    "notify_email": {
      "type": "boolean",
      "default": true,
      "description": "Email \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u044f"
    },
    "notify_new_cars": {
      "type": "boolean",
      "default": true,
      "description": "\u0423\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u044f \u043e \u043d\u043e\u0432\u044b\u0445 \u0430\u0432\u0442\u043e"
    },
    "notify_price_drop": {
      "type": "boolean",
      "default": true,
      "description": "\u0423\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u044f \u043e \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0438 \u0446\u0435\u043d"
    },
    "notify_messages": {
      "type": "boolean",
      "default": true,
      "description": "\u0423\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u044f \u043e \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f\u0445"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "ru",
        "en",
        "lv",
        "lt",
        "et"
      ],
      "default": "ru",
      "description": "\u041f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u0435\u043c\u044b\u0439 \u044f\u0437\u044b\u043a"
    },
    "two_factor_enabled": {
      "type": "boolean",
      "default": false,
      "description": "\u0414\u0432\u0443\u0445\u0444\u0430\u043a\u0442\u043e\u0440\u043d\u0430\u044f \u0430\u0432\u0442\u043e\u0440\u0438\u0437\u0430\u0446\u0438\u044f"
    }
  },
  "required": [
    "phone",
    "avatar",
    "city",
    "country",
    "dealer_id",
    "gdpr_consent_date"
  ]
}