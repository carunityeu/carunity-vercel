{
  "name": "DealerLead",
  "type": "object",
  "properties": {
    "dealer_id": {
      "type": "string",
      "description": "ID \u0434\u0438\u043b\u0435\u0440\u0430"
    },
    "car_id": {
      "type": "string",
      "description": "ID \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f"
    },
    "car_title": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0430\u0432\u0442\u043e"
    },
    "car_brand": {
      "type": "string",
      "description": "\u041c\u0430\u0440\u043a\u0430"
    },
    "car_model": {
      "type": "string",
      "description": "\u041c\u043e\u0434\u0435\u043b\u044c"
    },
    "car_price": {
      "type": "number",
      "description": "\u0426\u0435\u043d\u0430 \u0430\u0432\u0442\u043e"
    },
    "car_image": {
      "type": "string",
      "description": "URL \u0444\u043e\u0442\u043e \u0430\u0432\u0442\u043e"
    },
    "user_email": {
      "type": "string",
      "description": "Email \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f (\u0430\u043d\u043e\u043d\u0438\u043c\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439)"
    },
    "intent_score": {
      "type": "number",
      "description": "\u041e\u0446\u0435\u043d\u043a\u0430 \u043d\u0430\u043c\u0435\u0440\u0435\u043d\u0438\u044f (0-100)"
    },
    "buyer_profile": {
      "type": "object",
      "description": "\u041f\u0440\u043e\u0444\u0438\u043b\u044c \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f: \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0442\u0435\u043d\u0438\u044f, \u0444\u0438\u043b\u044c\u0442\u0440\u044b, \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "meeting",
        "sold",
        "rejected"
      ],
      "default": "new",
      "description": "\u0421\u0442\u0430\u0442\u0443\u0441 \u043b\u0438\u0434\u0430"
    },
    "dealer_notes": {
      "type": "string",
      "description": "\u0417\u0430\u043c\u0435\u0442\u043a\u0438 \u0434\u0438\u043b\u0435\u0440\u0430"
    },
    "description": {
      "type": "string",
      "description": "\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u043b\u0438\u0434\u0430"
    }
  },
  "required": [
    "dealer_id",
    "car_id",
    "user_email",
    "intent_score"
  ]
}