{
  "name": "TradeInOffer",
  "type": "object",
  "properties": {
    "car_id": {
      "type": "string",
      "description": "ID \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f"
    },
    "dealer_id": {
      "type": "string",
      "description": "ID \u0434\u0438\u043b\u0435\u0440\u0430"
    },
    "dealer_name": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0434\u0438\u043b\u0435\u0440\u0430"
    },
    "dealer_email": {
      "type": "string",
      "description": "Email \u0434\u0438\u043b\u0435\u0440\u0430"
    },
    "seller_email": {
      "type": "string",
      "description": "Email \u043f\u0440\u043e\u0434\u0430\u0432\u0446\u0430"
    },
    "car_title": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0430\u0432\u0442\u043e"
    },
    "car_brand": {
      "type": "string",
      "description": "\u041c\u0430\u0440\u043a\u0430 \u0430\u0432\u0442\u043e"
    },
    "car_model": {
      "type": "string",
      "description": "\u041c\u043e\u0434\u0435\u043b\u044c \u0430\u0432\u0442\u043e"
    },
    "car_year": {
      "type": "number",
      "description": "\u0413\u043e\u0434 \u0430\u0432\u0442\u043e"
    },
    "car_price": {
      "type": "number",
      "description": "\u0426\u0435\u043d\u0430 \u0430\u0432\u0442\u043e EUR"
    },
    "car_image": {
      "type": "string",
      "description": "URL \u0444\u043e\u0442\u043e \u0430\u0432\u0442\u043e"
    },
    "car_country": {
      "type": "string",
      "description": "\u0421\u0442\u0440\u0430\u043d\u0430 \u0430\u0432\u0442\u043e"
    },
    "car_mileage": {
      "type": "number",
      "description": "\u041f\u0440\u043e\u0431\u0435\u0433 \u0430\u0432\u0442\u043e"
    },
    "offer_type": {
      "type": "string",
      "enum": [
        "instant_buy",
        "consignment"
      ],
      "description": "\u0422\u0438\u043f \u043e\u0444\u0444\u0435\u0440\u0430"
    },
    "offered_price": {
      "type": "number",
      "description": "\u041f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u043d\u0430\u044f \u0446\u0435\u043d\u0430 (\u0434\u043b\u044f instant buy)"
    },
    "commission_percent": {
      "type": "number",
      "description": "\u041a\u043e\u043c\u0438\u0441\u0441\u0438\u044f % (\u0434\u043b\u044f consignment)"
    },
    "message": {
      "type": "string",
      "description": "\u0421\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0434\u0438\u043b\u0435\u0440\u0430"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "more_info_requested",
        "expired",
        "deal_in_progress",
        "completed",
        "cancelled"
      ],
      "default": "pending",
      "description": "\u0421\u0442\u0430\u0442\u0443\u0441 \u043e\u0444\u0444\u0435\u0440\u0430"
    },
    "seller_response": {
      "type": "string",
      "description": "\u041e\u0442\u0432\u0435\u0442 \u043f\u0440\u043e\u0434\u0430\u0432\u0446\u0430"
    },
    "description": {
      "type": "string",
      "description": "\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 trade-in \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0421\u0440\u043e\u043a \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u043e\u0444\u0444\u0435\u0440\u0430 (48\u0447)"
    },
    "additional_conditions": {
      "type": "string",
      "description": "\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0443\u0441\u043b\u043e\u0432\u0438\u044f"
    },
    "deal_status": {
      "type": "string",
      "enum": [
        "in_contact",
        "inspection_scheduled",
        "completed",
        "cancelled"
      ],
      "description": "\u0421\u0442\u0430\u0442\u0443\u0441 \u0441\u0434\u0435\u043b\u043a\u0438 \u043f\u043e\u0441\u043b\u0435 \u043f\u0440\u0438\u043d\u044f\u0442\u0438\u044f \u043e\u0444\u0444\u0435\u0440\u0430"
    },
    "not_interested": {
      "type": "boolean",
      "default": false,
      "description": "\u0414\u0438\u043b\u0435\u0440 \u043d\u0435 \u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043d \u0432 \u044d\u0442\u043e\u043c \u0430\u0432\u0442\u043e"
    },
    "fast_sale": {
      "type": "boolean",
      "default": false,
      "description": "\u041f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0431\u044b\u0441\u0442\u0440\u043e\u0439 \u043f\u0440\u043e\u0434\u0430\u0436\u0438"
    },
    "seller_phone": {
      "type": "string",
      "description": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d \u043f\u0440\u043e\u0434\u0430\u0432\u0446\u0430 (\u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0441\u043b\u0435 \u0441\u0434\u0435\u043b\u043a\u0438)"
    },
    "dealer_phone": {
      "type": "string",
      "description": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d \u0434\u0438\u043b\u0435\u0440\u0430 (\u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0441\u043b\u0435 \u0441\u0434\u0435\u043b\u043a\u0438)"
    }
  },
  "required": [
    "car_id",
    "dealer_id",
    "seller_email",
    "offer_type"
  ]
}