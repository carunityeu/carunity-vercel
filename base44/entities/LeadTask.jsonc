{
  "name": "LeadTask",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "ID \u043b\u0438\u0434\u0430"
    },
    "dealer_id": {
      "type": "string",
      "description": "ID \u0434\u0438\u043b\u0435\u0440\u0430"
    },
    "type": {
      "type": "string",
      "enum": [
        "call",
        "meeting",
        "task"
      ],
      "description": "\u0422\u0438\u043f \u0437\u0430\u0434\u0430\u0447\u0438"
    },
    "title": {
      "type": "string",
      "description": "\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438"
    },
    "due_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u0438 \u0432\u0440\u0435\u043c\u044f \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "done",
        "cancelled"
      ],
      "default": "pending",
      "description": "\u0421\u0442\u0430\u0442\u0443\u0441"
    },
    "notes": {
      "type": "string",
      "description": "\u0417\u0430\u043c\u0435\u0442\u043a\u0438"
    }
  },
  "required": [
    "lead_id",
    "dealer_id",
    "type",
    "title"
  ]
}