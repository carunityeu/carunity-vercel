{
  "name": "Referral",
  "type": "object",
  "properties": {
    "inviter_email": {
      "type": "string",
      "description": "Email \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0432\u0448\u0435\u0433\u043e"
    },
    "inviter_code": {
      "type": "string",
      "description": "\u0420\u0435\u0444\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u043a\u043e\u0434 \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0432\u0448\u0435\u0433\u043e"
    },
    "invited_email": {
      "type": "string",
      "description": "Email \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0451\u043d\u043d\u043e\u0433\u043e"
    },
    "invited_name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0451\u043d\u043d\u043e\u0433\u043e"
    },
    "referral_code": {
      "type": "string",
      "description": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0440\u0435\u0444\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u043a\u043e\u0434"
    },
    "status": {
      "type": "string",
      "enum": [
        "registered",
        "action_completed",
        "rewarded"
      ],
      "default": "registered",
      "description": "\u0421\u0442\u0430\u0442\u0443\u0441 \u0440\u0435\u0444\u0435\u0440\u0430\u043b\u0430"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "listing_created",
        "dealer_subscribed",
        "none"
      ],
      "default": "none",
      "description": "\u0422\u0438\u043f \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u043e\u0433\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f"
    },
    "action_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f"
    },
    "instant_bonus_granted": {
      "type": "boolean",
      "default": false,
      "description": "\u041c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u044b\u0439 \u0431\u043e\u043d\u0443\u0441 \u043d\u0430\u0447\u0438\u0441\u043b\u0435\u043d"
    },
    "instant_bonus_granted_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u043d\u0430\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0431\u043e\u043d\u0443\u0441\u0430"
    },
    "main_bonus_granted": {
      "type": "boolean",
      "default": false,
      "description": "\u041e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u0431\u043e\u043d\u0443\u0441 \u043d\u0430\u0447\u0438\u0441\u043b\u0435\u043d"
    },
    "main_bonus_granted_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u043d\u0430\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0433\u043e \u0431\u043e\u043d\u0443\u0441\u0430"
    }
  },
  "required": [
    "inviter_email",
    "invited_email",
    "referral_code"
  ]
}