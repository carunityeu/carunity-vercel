{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporter_email": {
      "type": "string",
      "description": "Email \u0436\u0430\u043b\u043e\u0431\u0449\u0438\u043a\u0430"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "car",
        "user",
        "dealer"
      ],
      "description": "\u0422\u0438\u043f \u043e\u0431\u044a\u0435\u043a\u0442\u0430 \u0436\u0430\u043b\u043e\u0431\u044b"
    },
    "target_id": {
      "type": "string",
      "description": "ID \u043e\u0431\u044a\u0435\u043a\u0442\u0430"
    },
    "reason": {
      "type": "string",
      "enum": [
        "fraud",
        "inappropriate",
        "wrong_info",
        "duplicate",
        "sold",
        "other"
      ],
      "description": "\u041f\u0440\u0438\u0447\u0438\u043d\u0430 \u0436\u0430\u043b\u043e\u0431\u044b"
    },
    "description": {
      "type": "string",
      "description": "\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "resolved",
        "rejected"
      ],
      "default": "pending",
      "description": "\u0421\u0442\u0430\u0442\u0443\u0441"
    }
  },
  "required": [
    "reporter_email",
    "target_type",
    "target_id",
    "reason"
  ]
}