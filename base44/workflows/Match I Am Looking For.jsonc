{
  "name": "Match I Am Looking For",
  "description": "When a car becomes active, notify users who marked saved searches as 'I'm looking for this'",
  "trigger": {
    "condition": "${ .trigger.data.status == \"active\" }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Car"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "match_i_am_looking_for",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "matchIamLookingSearches",
            "args": {
              "car_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}